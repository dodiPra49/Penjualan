      "get": {
        "tags": [
          "Kategori"
        ],
        "summary": "Mengambil daftar data kategori produk",
        "description": "Mengambil seluruh data kategori produk dengan dukungan filter pencarian berdasarkan `nama_kategori` atau `keterangan`, opsi pengurutan (sorting), dan paginasi (pagination).",
        "operationId": "getKategoriList",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Kata kunci pencarian yang mencocokkan `nama_kategori` atau `keterangan`.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "Elektronik"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Kolom acuan untuk pengurutan data.",
            "required": false,
            "schema": {
              "type": "string",
              "default": "id_kategori",
              "enum": [
                "id_kategori",
                "nama_kategori",
                "keterangan"
              ],
              "example": "id_kategori"
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "description": "Arah pengurutan data (asc untuk ascending, desc untuk descending).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "asc",
              "enum": [
                "asc",
                "desc"
              ],
              "example": "asc"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Jumlah data per halaman untuk mengaktifkan paginasi. Jika tidak diisi, seluruh data akan ditampilkan.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "example": 10
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Nomor halaman saat pagination aktif.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar data kategori berhasil diambil.",
            "headers": {
              "X-Api-Module": {
                "$ref": "#/components/headers/X-Api-Module"
              },
              "X-Execution-Time-Ms": {
                "$ref": "#/components/headers/X-Execution-Time-Ms"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KategoriListResponse"
                }
              }
            }
          },
          "500": {
            "description": "Terjadi kesalahan internal pada server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Kategori"
        ],
        "summary": "Menambahkan data kategori baru",
        "description": "Menyimpan data kategori baru ke dalam tabel `kategori`. Field `nama_kategori` wajib diisi (maksimal 50 karakter), sedangkan `keterangan` bersifat opsional (maksimal 150 karakter).",
        "operationId": "storeKategori",
        "requestBody": {
          "required": true,
          "description": "Payload data kategori yang akan ditambahkan.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoreKategoriPayload"
              }
            }
