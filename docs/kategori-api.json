                }
              }
            }
          },
          "422": {
            "description": "Validasi gagal, parameter input tidak sesuai aturan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Gagal menambahkan data kategori karena kesalahan server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
