  "components": {
    "headers": {
      "X-Api-Module": {
        "description": "Identitas modul API penanggung jawab response.",
        "schema": {
          "type": "string",
          "example": "Kategori-CRUD"
        }
      },
      "X-Execution-Time-Ms": {
        "description": "Waktu eksekusi API dalam satuan milidetik.",
        "schema": {
          "type": "string",
          "example": "8.32"
        }
      }
    },
    "schemas": {
      "KategoriItem": {
        "type": "object",
        "properties": {
          "id_kategori": {
            "type": "integer",
            "example": 1,
            "description": "Identifier unik kategori (Primary Key, Auto Increment)"
          },
          "nama_kategori": {
            "type": "string",
            "maxLength": 50,
            "example": "Elektronik",
            "description": "Nama kategori produk"
          },
          "keterangan": {
            "type": "string",
            "maxLength": 150,
            "nullable": true,
            "example": "Perangkat dan aksesoris elektronik",
            "description": "Deskripsi atau catatan singkat mengenai kategori"
          }
        }
      },
      "StoreKategoriPayload": {
        "type": "object",
        "required": [
          "nama_kategori"
        ],
        "properties": {
          "nama_kategori": {
            "type": "string",
            "maxLength": 50,
            "description": "Nama kategori produk (wajib diisi, maksimal 50 karakter).",
            "example": "Peralatan Rumah Tangga"
          },
          "keterangan": {
            "type": "string",
            "maxLength": 150,
            "nullable": true,
            "description": "Keterangan atau deskripsi kategori (opsional, maksimal 150 karakter).",
            "example": "Perlengkapan dan perkakas rumah tangga"
          }
        }
      },
      "UpdateKategoriPayload": {
        "type": "object",
        "properties": {
          "nama_kategori": {
            "type": "string",
            "maxLength": 50,
            "description": "Nama kategori produk (maksimal 50 karakter).",
            "example": "Peralatan Rumah Tangga & Dapur"
          },
          "keterangan": {
            "type": "string",
            "maxLength": 150,
            "nullable": true,
            "description": "Keterangan atau deskripsi kategori (maksimal 150 karakter).",
            "example": "Perlengkapan, perabotan, dan perkakas dapur"
          }
        }
      },
      "KategoriSingleResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Data kategori berhasil ditambahkan."
          },
          "data": {
            "$ref": "#/components/schemas/KategoriItem"
          }
        }
      },
      "KategoriListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Data kategori berhasil diambil."
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KategoriItem"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer",
            "example": 1,
            "description": "Halaman saat ini (jika menggunakan pagination)"
          },
          "last_page": {
            "type": "integer",
            "example": 3,
            "description": "Halaman terakhir (jika menggunakan pagination)"
          },
          "per_page": {
            "type": "integer",
            "example": 10,
            "description": "Jumlah data per halaman (jika menggunakan pagination)"
          },
          "total": {
            "type": "integer",
            "example": 25,
            "description": "Total keseluruhan rekaman data kategori"
          }
        }
      },
      "SuccessMessageResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Data kategori berhasil dihapus."
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Validasi gagal, silakan periksa data yang Anda masukkan."
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": {
              "nama_kategori": [
                "Nama kategori wajib diisi.",
                "Nama kategori maksimal 50 karakter."
              ],
              "keterangan": [
                "Keterangan maksimal 150 karakter."
              ]
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
