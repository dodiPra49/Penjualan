{
  "openapi": "3.0.3",
  "info": {
    "title": "API Manajemen Data Pelanggan - Sistem Penjualan",
    "description": "Dokumentasi spesifikasi OpenAPI 3.0 (Swagger) untuk proses bisnis pengelolaan data pelanggan (CRUD dan Statistik Ringkasan) pada sistem penjualan berbasis Laravel.\n\n### Fitur Utama:\n- **List & Search Pelanggan**: Mengambil daftar pelanggan dengan fitur pencarian teks, filtering status, sorting dinamis, serta opsi pagination.\n- **Create Pelanggan**: Menambahkan data pelanggan baru dengan auto-generated kode pelanggan (`PLG-XXXX`) jika tidak diinput manual.\n- **Detail Pelanggan**: Menampilkan informasi lengkap satu pelanggan berdasarkan ID.\n- **Update Pelanggan**: Memperbarui informasi data pelanggan (mendukung metode PUT dan PATCH) disertai validasi keunikan kode pelanggan.\n- **Delete Pelanggan**: Menghapus data pelanggan dari database.\n- **Statistik Pelanggan**: Mendapatkan ringkasan total pelanggan, jumlah aktif, dan non-aktif.\n\n### Custom Response Headers:\nSetiap request yang melewati middleware API akan menghasilkan header:\n- `X-Api-Module`: Modul API yang menangani (`Pelanggan-CRUD`).\n- `X-Execution-Time-Ms`: Waktu pemrosesan request dalam milidetik.",
    "version": "1.0.0",
    "contact": {
      "name": "Tim Pengembang Sistem Penjualan",
      "email": "developer@example.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000/api",
      "description": "Local Development Server"
    },
    {
      "url": "http://127.0.0.1:8000/api",
      "description": "Localhost IP Alternative"
    }
  ],
  "tags": [
    {
      "name": "Pelanggan",
      "description": "Operasi CRUD dan statistik untuk data pelanggan"
    }
  ],
  "paths": {
    "/pelanggan": {
      "get": {
        "tags": [
          "Pelanggan"
        ],
        "summary": "Mengambil daftar data pelanggan",
        "description": "Mengambil seluruh data pelanggan dengan dukungan filter pencarian keyword, filter status, sorting fleksibel, dan pagination.",
        "operationId": "getPelangganList",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "description": "Kata kunci pencarian yang mencocokkan kode_pelanggan, nama_pelanggan, email, nomor_telepon, atau alamat.",
            "required": false,
            "schema": {
              "type": "string",
              "example": "Budi"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter status pelanggan (aktif atau nonaktif).",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "aktif",
                "nonaktif"
              ],
              "example": "aktif"
            }
          },
          {
            "name": "sort_by",
            "in": "query",
            "description": "Kolom acuan untuk pengurutan data.",
            "required": false,
            "schema": {
              "type": "string",
              "default": "created_at",
              "enum": [
                "id",
                "kode_pelanggan",
                "nama_pelanggan",
                "email",
                "status",
                "created_at",
                "updated_at"
              ],
              "example": "created_at"
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "description": "Arah pengurutan data (asc untuk ascending, desc untuk descending).",
            "required": false,
            "schema": {
              "type": "string",
              "default": "desc",
              "enum": [
                "asc",
                "desc"
              ],
              "example": "desc"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "description": "Jumlah data per halaman untuk mengaktifkan paginasi. Jika dikosongkan, seluruh data akan dikembalikan.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "example": 10
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Nomor halaman saat pagination aktif.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Data pelanggan berhasil diambil.",
            "headers": {
              "X-Api-Module": {
                "$ref": "#/components/headers/X-Api-Module"
              },
              "X-Execution-Time-Ms": {
                "$ref": "#/components/headers/X-Execution-Time-Ms"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PelangganListResponse"
                }
              }
            }
          },
          "500": {
            "description": "Terjadi kesalahan internal pada server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Pelanggan"
        ],
        "summary": "Menambahkan data pelanggan baru",
        "description": "Menyimpan data pelanggan baru ke dalam sistem. Jika `kode_pelanggan` dikosongkan, sistem akan mengenerate kode otomatis dengan format `PLG-XXXX`. Status default adalah `aktif`.",
        "operationId": "storePelanggan",
        "requestBody": {
          "required": true,
          "description": "Payload data pelanggan yang akan disimpan.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StorePelangganPayload"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Data pelanggan berhasil ditambahkan.",
            "headers": {
              "X-Api-Module": {
                "$ref": "#/components/headers/X-Api-Module"
              },
              "X-Execution-Time-Ms": {
                "$ref": "#/components/headers/X-Execution-Time-Ms"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PelangganSingleResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validasi gagal, parameter input tidak sesuai aturan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Gagal menambahkan data pelanggan karena kesalahan server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/pelanggan/stats/summary": {
      "get": {
        "tags": [
          "Pelanggan"
        ],
        "summary": "Mengambil ringkasan statistik data pelanggan",
        "description": "Mengembalikan metrik statistik ringkas mengenai total pelanggan, jumlah pelanggan dengan status aktif, dan jumlah non-aktif.",
        "operationId": "getPelangganStats",
        "responses": {
          "200": {
            "description": "Statistik pelanggan berhasil dimuat.",
            "headers": {
              "X-Api-Module": {
                "$ref": "#/components/headers/X-Api-Module"
              },
              "X-Execution-Time-Ms": {
                "$ref": "#/components/headers/X-Execution-Time-Ms"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PelangganStatsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Gagal memuat statistik pelanggan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/pelanggan/{id}": {
      "get": {
        "tags": [
          "Pelanggan"
        ],
        "summary": "Mengambil detail data pelanggan",
        "description": "Mengambil detail data pelanggan spesifik berdasarkan identifier ID unik.",
        "operationId": "getPelangganById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID numerik pelanggan.",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detail pelanggan berhasil ditemukan.",
            "headers": {
              "X-Api-Module": {
                "$ref": "#/components/headers/X-Api-Module"
              },
              "X-Execution-Time-Ms": {
                "$ref": "#/components/headers/X-Execution-Time-Ms"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PelangganSingleResponse"
                }
              }
            }
          },
          "404": {
            "description": "Data pelanggan dengan ID tersebut tidak ditemukan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Terjadi kesalahan internal pada server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Pelanggan"
        ],
        "summary": "Memperbarui data pelanggan (Full Update)",
        "description": "Memperbarui field data pelanggan secara menyeluruh berdasarkan ID pelanggan.",
        "operationId": "updatePelangganPut",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID numerik pelanggan yang akan diupdate.",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Data pembaruan pelanggan.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePelangganPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data pelanggan berhasil diperbarui.",
            "headers": {
              "X-Api-Module": {
                "$ref": "#/components/headers/X-Api-Module"
              },
              "X-Execution-Time-Ms": {
                "$ref": "#/components/headers/X-Execution-Time-Ms"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PelangganSingleResponse"
                }
              }
            }
          },
          "404": {
            "description": "Data pelanggan tidak ditemukan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validasi gagal pada field yang dikirim.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Terjadi kesalahan internal pada server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Pelanggan"
        ],
        "summary": "Memperbarui sebagian data pelanggan (Partial Update)",
        "description": "Memperbarui satu atau beberapa field data pelanggan tertentu berdasarkan ID pelanggan.",
        "operationId": "updatePelangganPatch",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID numerik pelanggan yang akan diupdate.",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Data parsial pelanggan yang ingin diubah.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePelangganPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data pelanggan berhasil diperbarui.",
            "headers": {
              "X-Api-Module": {
                "$ref": "#/components/headers/X-Api-Module"
              },
              "X-Execution-Time-Ms": {
                "$ref": "#/components/headers/X-Execution-Time-Ms"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PelangganSingleResponse"
                }
              }
            }
          },
          "404": {
            "description": "Data pelanggan tidak ditemukan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validasi gagal pada data parsial yang dikirim.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Terjadi kesalahan internal pada server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Pelanggan"
        ],
        "summary": "Menghapus data pelanggan",
        "description": "Menghapus data pelanggan dari basis data secara permanen berdasarkan ID pelanggan.",
        "operationId": "deletePelanggan",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID numerik pelanggan yang akan dihapus.",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Data pelanggan berhasil dihapus.",
            "headers": {
              "X-Api-Module": {
                "$ref": "#/components/headers/X-Api-Module"
              },
              "X-Execution-Time-Ms": {
                "$ref": "#/components/headers/X-Execution-Time-Ms"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessMessageResponse"
                }
              }
            }
          },
          "404": {
            "description": "Data pelanggan tidak ditemukan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Terjadi kesalahan internal pada server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "headers": {
      "X-Api-Module": {
        "description": "Identitas modul API penanggung jawab response.",
        "schema": {
          "type": "string",
          "example": "Pelanggan-CRUD"
        }
      },
      "X-Execution-Time-Ms": {
        "description": "Waktu eksekusi API dalam satuan milidetik.",
        "schema": {
          "type": "string",
          "example": "12.45"
        }
      }
    },
    "schemas": {
      "PelangganItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1,
            "description": "Identifier unik pelanggan"
          },
          "kode_pelanggan": {
            "type": "string",
            "example": "PLG-0001",
            "description": "Kode unik pelanggan"
          },
          "nama_pelanggan": {
            "type": "string",
            "example": "Budi Santoso",
            "description": "Nama lengkap pelanggan"
          },
          "email": {
            "type": "string",
            "example": "budi@example.com",
            "description": "Alamat email pelanggan (atau '-' jika kosong)"
          },
          "nomor_telepon": {
            "type": "string",
            "example": "081234567890",
            "description": "Nomor telepon / WhatsApp pelanggan (atau '-' jika kosong)"
          },
          "alamat": {
            "type": "string",
            "example": "Jl. Merdeka No. 45, Jakarta",
            "description": "Alamat tempat tinggal pelanggan (atau '-' jika kosong)"
          },
          "status": {
            "type": "string",
            "enum": [
              "aktif",
              "nonaktif"
            ],
            "example": "aktif",
            "description": "Status keaktifan pelanggan"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-26 09:00:00",
            "description": "Timestamp pencatatan data pelanggan"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-26 09:15:00",
            "description": "Timestamp perubahan terakhir data pelanggan"
          }
        }
      },
      "StorePelangganPayload": {
        "type": "object",
        "required": [
          "nama_pelanggan"
        ],
        "properties": {
          "kode_pelanggan": {
            "type": "string",
            "maxLength": 20,
            "nullable": true,
            "description": "Kode unik pelanggan. Opsional; sistem akan mengenerate otomatis jika kosong (PLG-XXXX).",
            "example": "PLG-0001"
          },
          "nama_pelanggan": {
            "type": "string",
            "maxLength": 100,
            "description": "Nama lengkap pelanggan.",
            "example": "Budi Santoso"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 100,
            "nullable": true,
            "description": "Email pelanggan yang valid.",
            "example": "budi@example.com"
          },
          "nomor_telepon": {
            "type": "string",
            "maxLength": 20,
            "nullable": true,
            "description": "Nomor kontak pelanggan.",
            "example": "081234567890"
          },
          "alamat": {
            "type": "string",
            "nullable": true,
            "description": "Alamat lengkap pelanggan.",
            "example": "Jl. Merdeka No. 45, Jakarta"
          },
          "status": {
            "type": "string",
            "enum": [
              "aktif",
              "nonaktif"
            ],
            "default": "aktif",
            "nullable": true,
            "description": "Status keaktifan pelanggan.",
            "example": "aktif"
          }
        }
      },
      "UpdatePelangganPayload": {
        "type": "object",
        "properties": {
          "kode_pelanggan": {
            "type": "string",
            "maxLength": 20,
            "description": "Kode unik pelanggan (harus unik di database, kecuali untuk ID milik record ini).",
            "example": "PLG-0001"
          },
          "nama_pelanggan": {
            "type": "string",
            "maxLength": 100,
            "description": "Nama lengkap pelanggan.",
            "example": "Budi Santoso Nugroho"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 100,
            "nullable": true,
            "description": "Alamat email pelanggan.",
            "example": "budi.nugroho@example.com"
          },
          "nomor_telepon": {
            "type": "string",
            "maxLength": 20,
            "nullable": true,
            "description": "Nomor telepon pelanggan.",
            "example": "081298765432"
          },
          "alamat": {
            "type": "string",
            "nullable": true,
            "description": "Alamat pelanggan.",
            "example": "Jl. Jenderal Sudirman Kav. 21, Jakarta Pusat"
          },
          "status": {
            "type": "string",
            "enum": [
              "aktif",
              "nonaktif"
            ],
            "description": "Status keaktifan pelanggan.",
            "example": "aktif"
          }
        }
      },
      "PelangganSingleResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Data pelanggan berhasil ditambahkan."
          },
          "data": {
            "$ref": "#/components/schemas/PelangganItem"
          }
        }
      },
      "PelangganListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Data pelanggan berhasil diambil."
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PelangganItem"
            }
          },
          "meta": {
            "$ref": "#/components/schemas/PaginationMeta"
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "current_page": {
            "type": "integer",
            "example": 1,
            "description": "Halaman saat ini (jika menggunakan pagination)"
          },
          "last_page": {
            "type": "integer",
            "example": 5,
            "description": "Halaman terakhir (jika menggunakan pagination)"
          },
          "per_page": {
            "type": "integer",
            "example": 10,
            "description": "Jumlah data per halaman (jika menggunakan pagination)"
          },
          "total": {
            "type": "integer",
            "example": 48,
            "description": "Total keseluruhan data pelanggan"
          }
        }
      },
      "PelangganStatsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Statistik pelanggan berhasil dimuat."
          },
          "data": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "example": 150,
                "description": "Total seluruh pelanggan"
              },
              "aktif": {
                "type": "integer",
                "example": 142,
                "description": "Total pelanggan berstatus aktif"
              },
              "nonaktif": {
                "type": "integer",
                "example": 8,
                "description": "Total pelanggan berstatus nonaktif"
              }
            }
          }
        }
      },
      "SuccessMessageResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Data pelanggan berhasil dihapus."
          }
        }
      },
      "ValidationErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "message": {
            "type": "string",
            "example": "Validasi gagal, silakan periksa data yang Anda masukkan."
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "example": {
              "nama_pelanggan": [
                "Nama pelanggan wajib diisi."
              ],
              "email": [
                "Format email tidak valid."
              ],
              "kode_pelanggan": [
                "Kode pelanggan sudah digunakan."
              ]
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
