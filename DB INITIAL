
-- =====================================================================
-- RANCANGAN BASIS DATA TRANSAKSI PENJUALAN
-- Mencakup relasi: One-to-One, One-to-Many, Many-to-Many
-- =====================================================================

CREATE DATABASE IF NOT EXISTS db_penjualan;
USE db_penjualan;

-- =====================================================================
-- 1. TABEL KATEGORI
--    Relasi: Kategori (1) --- (N) Produk  => ONE TO MANY
-- =====================================================================
CREATE TABLE kategori (
    id_kategori     INT AUTO_INCREMENT PRIMARY KEY,
    nama_kategori   VARCHAR(50) NOT NULL,
    keterangan      VARCHAR(150)
);

-- =====================================================================
-- 2. TABEL PRODUK
-- =====================================================================
CREATE TABLE produk (
    id_produk       INT AUTO_INCREMENT PRIMARY KEY,
    id_kategori     INT NOT NULL,
    nama_produk     VARCHAR(100) NOT NULL,
    harga_jual      DECIMAL(12,2) NOT NULL,
    stok            INT NOT NULL DEFAULT 0,
    CONSTRAINT fk_produk_kategori
        FOREIGN KEY (id_kategori) REFERENCES kategori(id_kategori)
        ON UPDATE CASCADE ON DELETE RESTRICT
);

-- =====================================================================
-- 3. TABEL PELANGGAN
-- =====================================================================
CREATE TABLE pelanggan (
    id_pelanggan    INT AUTO_INCREMENT PRIMARY KEY,
    nama_pelanggan  VARCHAR(100) NOT NULL,
    alamat          VARCHAR(200),
    telepon         VARCHAR(20)
);

-- =====================================================================
-- 4. TABEL DETAIL_PELANGGAN
--    Relasi: Pelanggan (1) --- (1) Detail_Pelanggan => ONE TO ONE
--    (data tambahan/privat pelanggan dipisah dari data utama)
-- =====================================================================
CREATE TABLE detail_pelanggan (
    id_pelanggan    INT PRIMARY KEY,
    tanggal_lahir   DATE,
    jenis_kelamin   ENUM('L','P'),
    email           VARCHAR(100) UNIQUE,
    CONSTRAINT fk_detail_pelanggan
        FOREIGN KEY (id_pelanggan) REFERENCES pelanggan(id_pelanggan)
        ON UPDATE CASCADE ON DELETE CASCADE
);

-- =====================================================================
-- 5. TABEL KARYAWAN
--    Relasi: Karyawan (1) --- (N) Transaksi => ONE TO MANY
-- =====================================================================
CREATE TABLE karyawan (
    id_karyawan     INT AUTO_INCREMENT PRIMARY KEY,
    nama_karyawan   VARCHAR(100) NOT NULL,
    jabatan         VARCHAR(50)
);

-- =====================================================================
-- 6. TABEL TRANSAKSI (Header Penjualan)
--    Relasi: Pelanggan (1)---(N) Transaksi, Karyawan (1)---(N) Transaksi
-- =====================================================================
CREATE TABLE transaksi (
    id_transaksi    INT AUTO_INCREMENT PRIMARY KEY,
    id_pelanggan    INT NOT NULL,
    id_karyawan     INT NOT NULL,
    tanggal_transaksi DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    total_bayar     DECIMAL(14,2) NOT NULL DEFAULT 0,
    CONSTRAINT fk_transaksi_pelanggan
        FOREIGN KEY (id_pelanggan) REFERENCES pelanggan(id_pelanggan)
        ON UPDATE CASCADE ON DELETE RESTRICT,
    CONSTRAINT fk_transaksi_karyawan
        FOREIGN KEY (id_karyawan) REFERENCES karyawan(id_karyawan)
        ON UPDATE CASCADE ON DELETE RESTRICT
);

-- =====================================================================
-- 7. TABEL DETAIL_TRANSAKSI
--    Relasi: Transaksi (N) --- (N) Produk => MANY TO MANY
--    (tabel penghubung/junction table dengan atribut tambahan)
-- =====================================================================
CREATE TABLE detail_transaksi (
    id_detail_transaksi INT AUTO_INCREMENT PRIMARY KEY,
    id_transaksi    INT NOT NULL,
    id_produk       INT NOT NULL,
    jumlah          INT NOT NULL,
    harga_satuan    DECIMAL(12,2) NOT NULL,
    subtotal        DECIMAL(14,2) NOT NULL,
    CONSTRAINT fk_dt_transaksi
        FOREIGN KEY (id_transaksi) REFERENCES transaksi(id_transaksi)
        ON UPDATE CASCADE ON DELETE CASCADE,
    CONSTRAINT fk_dt_produk
        FOREIGN KEY (id_produk) REFERENCES produk(id_produk)
        ON UPDATE CASCADE ON DELETE RESTRICT,
    UNIQUE KEY uq_transaksi_produk (id_transaksi, id_produk)
);

-- =====================================================================
-- 8. TABEL SUPPLIER
-- =====================================================================
CREATE TABLE supplier (
    id_supplier     INT AUTO_INCREMENT PRIMARY KEY,
    nama_supplier   VARCHAR(100) NOT NULL,
    alamat          VARCHAR(200),
    telepon         VARCHAR(20)
);

-- =====================================================================
-- 9. TABEL SUPPLIER_PRODUK
--    Relasi: Supplier (N) --- (N) Produk => MANY TO MANY
--    (satu produk bisa dipasok banyak supplier, satu supplier
--     bisa memasok banyak produk, dengan harga beli berbeda-beda)
-- =====================================================================
CREATE TABLE supplier_produk (
    id_supplier     INT NOT NULL,
    id_produk       INT NOT NULL,
    harga_beli      DECIMAL(12,2) NOT NULL,
    PRIMARY KEY (id_supplier, id_produk),
    CONSTRAINT fk_sp_supplier
        FOREIGN KEY (id_supplier) REFERENCES supplier(id_supplier)
        ON UPDATE CASCADE ON DELETE CASCADE,
    CONSTRAINT fk_sp_produk
        FOREIGN KEY (id_produk) REFERENCES produk(id_produk)
        ON UPDATE CASCADE ON DELETE CASCADE
);

