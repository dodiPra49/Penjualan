					<font fontName="SansSerif" size="18" isBold="true"/>
				</textElement>
				<text><![CDATA[SISTEM MANAJEMEN PENJUALAN]]></text>
			</staticText>
			<textField>
				<reportElement x="0" y="27" width="555" height="20" forecolor="#4F46E5" uuid="a4768393-27cf-45f8-b328-560caea3a2fa"/>
