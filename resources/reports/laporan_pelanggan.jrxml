<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="laporan_pelanggan" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="25" bottomMargin="25" uuid="d6f3b0e2-8991-4e44-8848-0d85ef4e0821">
	<parameter name="STATUS_FILTER" class="java.lang.String">
		<defaultValueExpression><![CDATA["semua"]]></defaultValueExpression>
	</parameter>
	<parameter name="REPORT_TITLE" class="java.lang.String">
		<defaultValueExpression><![CDATA["LAPORAN DATA PELANGGAN"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 
            id, 
            kode_pelanggan, 
            nama_pelanggan, 
            IFNULL(email, '-') AS email, 
            IFNULL(nomor_telepon, '-') AS nomor_telepon, 
            IFNULL(alamat, '-') AS alamat, 
            status 
        FROM pelanggans 
        WHERE ($P{STATUS_FILTER} = 'semua' OR $P{STATUS_FILTER} IS NULL OR $P{STATUS_FILTER} = '' OR status = $P{STATUS_FILTER}) 
        ORDER BY kode_pelanggan ASC]]>
	</queryString>
	<field name="id" class="java.lang.Long"/>
	<field name="kode_pelanggan" class="java.lang.String"/>
	<field name="nama_pelanggan" class="java.lang.String"/>
	<field name="email" class="java.lang.String"/>
	<field name="nomor_telepon" class="java.lang.String"/>
	<field name="alamat" class="java.lang.String"/>
	<field name="status" class="java.lang.String"/>
	<variable name="TOTAL_RECORDS" class="java.lang.Integer" calculation="Count">
		<variableExpression><![CDATA[$F{id}]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="85" splitType="Stretch">
