				<reportElement x="0" y="2" width="300" height="15" forecolor="#475569" uuid="2e3678fb-0eb2-43bb-85bb-f8db9509df65"/>
				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" size="9" isItalic="true"/>
				</textElement>
				<textFieldExpression><![CDATA["Filter Status: " + ($P{STATUS_FILTER}.equalsIgnoreCase("aktif") ? "Aktif Saja" : ($P{STATUS_FILTER}.equalsIgnoreCase("nonaktif") ? "Nonaktif Saja" : "Semua Pelanggan"))]]></textFieldExpression>
