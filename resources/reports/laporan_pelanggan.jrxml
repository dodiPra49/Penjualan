					<font fontName="SansSerif" size="13" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression>
			</textField>
			<textField pattern="EEEEE, dd MMMMM yyyy HH:mm:ss">
				<reportElement x="0" y="50" width="555" height="15" forecolor="#64748B" uuid="ceb40c21-f09b-43d9-959c-703c1538fc12"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="SansSerif" size="9"/>
				</textElement>
				<textFieldExpression><![CDATA["Dicetak pada: " + new java.text.SimpleDateFormat("dd MMMM yyyy, HH:mm 'WIB'", new java.util.Locale("id", "ID")).format(new java.util.Date())]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="0" y="75" width="555" height="1" forecolor="#CBD5E1" uuid="8851c890-e5ca-49d7-832f-48d8b99c8bf2"/>
				<graphicElement>
					<pen lineWidth="1.5" lineStyle="Solid"/>
				</graphicElement>
			</line>
		</band>
	</title>
